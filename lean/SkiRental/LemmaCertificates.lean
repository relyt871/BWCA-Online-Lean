import SkiRental.Certificates

/-!
Generated exact rational certificates for the finite algebraic checks in
`lem:buy-by-breakeven-threshold-bound` and the concavity estimate used in
`lem:general-tail-reduction`.

These coefficient lists are produced by clearing the positive denominators in
the paper's finite expressions, applying the affine changes of variables to
the unit cube/square, and converting the resulting power-basis polynomial to a
Bernstein basis of the indicated degree.  The theorems in this file check the
sign of every listed rational coefficient.
-/

namespace SkiRental.Certificates

def allNonnegative (xs : List Q) : Bool :=
  xs.all (fun x => decide (0 ≤ x))

def allRowsPositive (xss : List (List Q)) : Bool :=
  xss.all allPositive

def allRowsNonnegative (xss : List (List Q)) : Bool :=
  xss.all allNonnegative

def allBlocksPositive (xsss : List (List (List Q))) : Bool :=
  xsss.all allRowsPositive

